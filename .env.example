# Copy this file to .env (repo root) AND to apps/web/.env.local, then fill in real values.
# Next.js only reads env vars from its own app directory, not the monorepo root — see the note
# at the bottom of this file. Never commit .env or .env.local — both are already in .gitignore.

# ---------- Supabase (Phase 1) ----------
# Project Settings -> Database -> Connection string (use the "Transaction" pooler for the app,
# "Session" pooler or direct connection for migrations).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Project Settings -> API. NEXT_PUBLIC_ vars are safe to expose to the browser by design — the
# publishable key only works through RLS, it grants nothing on its own. Note the current naming:
# Supabase renamed "anon key" to "publishable key" — using the old NEXT_PUBLIC_SUPABASE_ANON_KEY
# name will silently leave the client unconfigured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Needed by the Trigger.dev worker, and by it alone, to upload page screenshots to the private
# `page-screenshots` bucket. The database itself is reached through DATABASE_URL and Drizzle;
# Storage has no Postgres route, so this is the one thing that needs a key.
#
# It must never appear in apps/web's environment: it bypasses every RLS policy in
# packages/db/drizzle/0002_rls_policies.sql, and anything in apps/web can end up in the browser.
# Dashboard → Project Settings → API keys → `service_role`. Put the value in apps/jobs/.env,
# never here — this file is committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Cloud (Phase 3 — discovery) ----------
# One project, restricted to only the APIs below. Set quota limits before the first real call —
# see pre-build-risks-and-api-limits.md section 0 and SETUP.md's Phase 3 section.
# GOOGLE_PLACES_API_KEY covers BOTH Places API (New) and the Geocoding API — one restricted key,
# two APIs enabled on it (packages/providers/src/config.ts).
# One key covers all three Google calls: Places, PageSpeed and YouTube Data v3 all fall back to
# it (packages/providers/src/config.ts). Enable the three APIs on the same restricted key.
GOOGLE_PLACES_API_KEY=

# ---------- Trigger.dev (Phase 3) ----------
# The project REF (not a secret) lives in apps/jobs/trigger.config.ts, not here — only the secret
# key belongs in .env. Dashboard -> Project -> API Keys.
TRIGGER_SECRET_KEY=

# Not used. Opening lines are built from templates keyed to check IDs, deliberately — see
# packages/core/src/outreach/opener.ts for why a model does not write them.
# ANTHROPIC_API_KEY=

# ---------- Search ranking provider (Phase 5 — do not buy yet) ----------
SERP_API_KEY=

# ---------- Apify (Instagram profiles, Meta ads) ----------
# apify.com -> Settings -> Integrations -> Personal API token. Billed per result; the confirm
# screen at /records/enrich prices every purchase before it happens.
APIFY_TOKEN=

# ---------- Google Gemini (rule suggestions, business briefings) ----------
# aistudio.google.com -> Get API key. Used by two interactive features only; both show what they
# produced before anything is saved.
GEMINI_API_KEY=


# ---------- Trigger.dev (the machine that runs every background job) ----------
# Open your project, switch the environment selector at the top to the one you want, then the
# API keys page. The key is scoped to that environment and the environments are sealed off from
# each other: a development key cannot reach production and vice versa.
#
#   tr_dev_...     local only. Works while `trigger dev` is running on your own computer.
#   tr_prod_...    the deployed worker.
#
# Getting this wrong does NOT produce an error. A development key on the live site is accepted,
# the job is queued into the development environment, and with your computer off it waits there
# for ever while the screen says it started. apps/web/lib/enqueue.ts refuses to enqueue in that
# state and says so, because the silent version cost a live "Find businesses" run.
TRIGGER_SECRET_KEY=


# ---------- Where each variable goes ----------
#
# LOCAL
#   apps/web/.env.local   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#                         GEMINI_API_KEY, TRIGGER_SECRET_KEY (the tr_dev_ one)
#   apps/jobs/.env        DATABASE_URL, GOOGLE_PLACES_API_KEY, APIFY_TOKEN, GEMINI_API_KEY,
#                         SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   repo root .env        DATABASE_URL, for packages/db's drizzle-kit
#
# PRODUCTION
#   Vercel  → Settings → Environment Variables
#           NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#           GEMINI_API_KEY, TRIGGER_SECRET_KEY (the tr_prod_ one)
#           Never SUPABASE_SERVICE_ROLE_KEY here: anything in this app's environment can reach
#           the browser, and that key bypasses every RLS policy in the database.
#
#   Trigger.dev → your project → Environment Variables → New environment variable, with the
#           environment set to Production
#           DATABASE_URL, GOOGLE_PLACES_API_KEY, APIFY_TOKEN, GEMINI_API_KEY,
#           SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#           NOT TRIGGER_SECRET_KEY — the worker already knows which project it belongs to.
#
# The two local files overlap on the Supabase URL, because Next.js will not read a .env sitting
# outside apps/web.
